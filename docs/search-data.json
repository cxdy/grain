---
layout: null
permalink: /search-data.json
search: false
---
[
{% assign first = true %}
{% for page in site.pages %}
  {% if page.title and page.url and page.url != '/search-data.json' and page.url != '/' %}
  {% unless page.search == false %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | relative_url | jsonify }},
    "description": {{ page.description | default: '' | jsonify }},
    "section": {{ page.section | default: '' | jsonify }},
    "content": {{ page.content | markdownify | strip_html | normalize_whitespace | truncatewords: 120 | jsonify }}
  }
  {% endunless %}
  {% endif %}
{% endfor %}
]
