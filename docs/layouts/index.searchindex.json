{{- $pages := slice -}}
{{- range site.Pages -}}
  {{- if and .RelPermalink (hasPrefix .RelPermalink "/docs/") (not .IsHome) -}}
    {{- $plain := .Plain | truncate 2500 -}}
    {{- $kw := "" -}}
    {{- with .Params.keywords -}}
      {{- if reflect.IsSlice . -}}
        {{- $kw = delimit . " " -}}
      {{- else -}}
        {{- $kw = printf "%v" . -}}
      {{- end -}}
    {{- end -}}
    {{- $pages = $pages | append (dict
      "title" .Title
      "url" .RelPermalink
      "description" (.Description | default "")
      "section" (.Params.section | default "")
      "keywords" $kw
      "content" $plain
    ) -}}
  {{- end -}}
{{- end -}}
{{- $pages | jsonify -}}
